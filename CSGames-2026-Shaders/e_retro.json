{
  "version": "1.0",
  "render_targets": [
    {
      "name": "depth",
      "width": 1,
      "height": 1,
      "type": "depth",
    }
  ],
  "layers": [
    { "pass": "clear", "targets": [ "screen", "depth" ] },
    {
