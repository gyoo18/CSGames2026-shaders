      "depth_test": true,
      "depth_write": true,
      "culling": "none",
      "targets": [ "screen", "depth" ],
      "macros": [ "SCREEN" ],
    },
    {
      "fragment": "e_retro_gaussian.fs",
      "uniforms": [ { "name": "u_texture", "value": "screen" } ]
